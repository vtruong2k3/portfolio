# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio_db"

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-secure-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# ─── Admin account (used by seed script) ─────────────────────────────────────
ADMIN_EMAIL="admin@portfolio.local"
ADMIN_PASSWORD="changeme123"

# ─── SMTP (Req 12.7) ─────────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
CONTACT_NOTIFY_EMAIL="your-email@gmail.com"

# ─── Contact rate limit (Req 13) ─────────────────────────────────────────────
CONTACT_RATE_TTL=60000      # window in ms (60s)
CONTACT_RATE_LIMIT=5        # max requests per window per IP

# ─── Upload (Req 16.3) ───────────────────────────────────────────────────────
UPLOAD_DIR="uploads"
PUBLIC_BASE_URL="http://localhost:3001"

# ─── Web origin for CORS (Req 18.2) ──────────────────────────────────────────
WEB_ORIGIN="http://localhost:3000"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
